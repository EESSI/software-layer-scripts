# RVA23U64-floor host: unknown vendor; ISA tokens cover the detectable
# mandatory RVA23U64 subset (includes V, zicbo*, zicond, zimop/zcmop, zcb, zfa,
# zawrs, vector crypto-adjacent zv*, etc.) so the host also matches the rva22
# and rva20 floors.
processor	: 0
hart		: 0
isa		: rv64imafdcv_zicsr_zifencei_zicntr_zihpm_zihintpause_zihintntl_zba_zbb_zbs_zicbom_zicbop_zicboz_zfhmin_zkt_zicond_zimop_zcmop_zcb_zfa_zawrs_zvfhmin_zvbb_zvkt
mmu		: sv39
mvendorid	: 0x123
marchid		: 0x0
mimpid		: 0x0
